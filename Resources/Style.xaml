<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
        <Style x:Key="ControlBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="MenuBtnstyle" TargetType="{x:Type Button}">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="GhostWhite"/>
                <Setter Property="Background" Value="#31394A"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF80D8FF" Offset="0.0" />
                            <GradientStop Color="#FF0057FF" Offset="0.5" />
                            <GradientStop Color="#FF00008B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Calibri Light"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2E3440"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#3B4252"/>
                        <Setter Property="BorderBrush" Value="#3B4252"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="btnClose" TargetType="{x:Type Button}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#cc4141"/>
            </Style>
            
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="btnMinimize" TargetType="{x:Type Button}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#cc8741"/>
            </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="customerNameTextBox" TargetType="TextBox">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="Calibri Light"/>
                <Setter Property="Background" Value="#31394A"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="GhostWhite"/>
                <Setter Property="BorderBrush" Value="#161A22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ScrollViewer
                        x:Name="PART_ContentHost"
                        Margin="{TemplateBinding Margin}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2E3440"/>
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF80D8FF" Offset="0.0" />
                                    <GradientStop Color="#FF0057FF" Offset="0.5" />
                                    <GradientStop Color="#FF00008B" Offset="1.0" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="homeviewBtn" TargetType="{x:Type Button}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Background" Value="#31394A"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="GhostWhite"/>
                <Setter Property="BorderBrush" Value="#161A22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2E3440"/>
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF80D8FF" Offset="0.0" />
                                    <GradientStop Color="#FF0057FF" Offset="0.5" />
                                    <GradientStop Color="#FF00008B" Offset="1.0" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#3B4252"/>
                        <Setter Property="BorderBrush" Value="#3B4252"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>