<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
        <Style x:Key="ControlBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="MenuBtnstyle" TargetType="{x:Type Button}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Background" Value="#31394A"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="GhostWhite"/>
                <Setter Property="BorderBrush" Value="#161A22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="White"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="White" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#3B4252"/>
                        <Setter Property="BorderBrush" Value="#3B4252"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="btnClose" TargetType="{x:Type Button}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#cc4141"/>
            </Style>
            
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="btnMinimize" TargetType="{x:Type Button}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#cc8741"/>
            </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="customerNameTextBox" TargetType="TextBox">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="Calibri Light"/>
                <Setter Property="Background" Value="#31394A"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="GhostWhite"/>
                <Setter Property="BorderBrush" Value="#161A22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ScrollViewer
                        x:Name="PART_ContentHost"
                        Margin="{TemplateBinding Margin}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="White"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
        <ResourceDictionary>
            <Style x:Key="homeviewBtn" TargetType="{x:Type Button}">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="GhostWhite"/>
                <Setter Property="Background" Value="#1D1D1D"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3B4252"/>
                        <Setter Property="BorderBrush" Value="#3B4252"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="2"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="#3B4252"/>
                        <Setter Property="BorderBrush" Value="#3B4252"/>
                        <Setter Property="BorderThickness" Value="4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
        <ResourceDictionary>
            <Storyboard x:Key="OpenHelpAnimation">

                <!-- Rectangle expands -->
                <DoubleAnimation Storyboard.TargetName="HelpRect"
                     Storyboard.TargetProperty="Width"
                     From="0" To="166"
                     Duration="0:0:0.4"
                     DecelerationRatio="0.8"/>

                <!-- Rectangle fades in -->
                <DoubleAnimation Storyboard.TargetName="HelpRect"
                     Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="0:0:0.2"/>

                <!-- Text fades in -->
                <DoubleAnimation Storyboard.TargetName="HelpText"
                     Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     BeginTime="0:0:0.2"
                     Duration="0:0:0.3"/>

            </Storyboard>
            <Storyboard x:Key="CloseHelpAnimation">

                <!-- Text fades out -->
                <DoubleAnimation Storyboard.TargetName="HelpText"
                     Storyboard.TargetProperty="Opacity"
                     From="1" To="0"
                     Duration="0:0:0.15"/>

                <!-- Rectangle fades out -->
                <DoubleAnimation Storyboard.TargetName="HelpRect"
                     Storyboard.TargetProperty="Opacity"
                     From="1" To="0"
                     Duration="0:0:0.2"/>

                <!-- Rectangle shrinks -->
                <DoubleAnimation Storyboard.TargetName="HelpRect"
                     Storyboard.TargetProperty="Width"
                     From="166" To="0"
                     Duration="0:0:0.4"
                     BeginTime="0:0:0.05"
                     DecelerationRatio="0.8"/>

            </Storyboard>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>