<UserControl x:Class="msptool.Views.CloneDiskViewPg2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:msptool.ViewModels"
             xmlns:views="clr-namespace:msptool.Views"
             mc:Ignorable="d"
           Loaded="CloneDiskViewPg2_Loaded"
             d:DesignHeight="390" d:DesignWidth="560" Height="390" Background="Transparent" d:DataContext="{d:DesignInstance Type=viewmodels:CloneDiskViewModel}">


    <Border CornerRadius="25" Background="#1D1D1D" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />

            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="30*"/>

            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Destination Disk" FontSize="20" Foreground="GhostWhite" FontFamily="Calibri" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" FontSize="15" Foreground="GhostWhite" FontFamily="Calibri" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top">
                Warning: If you don't know what you're doing please consult the manual.
                <LineBreak/>
                Improper use can result in data loss.
            </TextBlock>
            <Border Grid.ColumnSpan="3"
        Grid.RowSpan="3"
        BorderThickness="3"
        BorderBrush="#31394A"
        Height="200"
        Width="400"
        Margin="10,50,10,0">
                <StackPanel x:Name="ButtonPanelCloneDest">
                </StackPanel>
            </Border>
            <Button Grid.Row="3" Grid.Column="3" Content="Next" Style="{StaticResource dataviewbut}" Height="30" Width="60" Margin="50,90,0,0" FontFamily="Calibri" FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center" Command="{Binding UpdateViewCommand}" CommandParameter="CloneDiskFinal"/>
        </Grid>
    </Border>
</UserControl>
