<UserControl x:Class="msptool.Views.Clone_Disk"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:msptool.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="560">
    <Border CornerRadius="25" Background="#1D1D1D">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="30*"/>

            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="1" Text="Source Disk:" FontSize="20" Background="Transparent"  Foreground="GhostWhite" FontFamily="Calibri" FontWeight="SemiBold" Margin="15,35,0,0"/>
            <TextBlock Grid.ColumnSpan="3" Grid.Row="0" Text="Warning: All data on the destination disk will be lost/overwritten!" FontSize="15" Background="Transparent"  Foreground="GhostWhite" FontFamily="Calibri" FontWeight="SemiBold" Margin="15,35,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="0" Grid.Row="2" Text="Destination Disk:" FontSize="20" Background="Transparent"  Foreground="GhostWhite" FontFamily="Calibri" FontWeight="SemiBold" Margin="15,35,0,0" HorizontalAlignment="Left"/>
        </Grid>
    </Border>
</UserControl>
