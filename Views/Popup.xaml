<Window x:Class="Data_Transfer_App.Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Data_Transfer_App"
        mc:Ignorable="d" WindowStyle="None"
        Title="{Binding Title}" Height="200" Width="250"
       Background="Transparent"
        AllowsTransparency="True"
        >
    <Border Background="#1E1E1E" CornerRadius="15" Padding="0">
        <Grid>


            <Border 
         Grid.Column="0"
         Background="{Binding TitleBG}"
         HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch">
                <Border.CornerRadius>
                    <CornerRadius TopLeft="15" TopRight="15" BottomLeft="0" BottomRight="0"/>
                </Border.CornerRadius>
                <TextBlock Text="{Binding Title}"
FontSize="14"
FontWeight="Bold"
Foreground="White"
VerticalAlignment="Center"
HorizontalAlignment="Left"
Margin="12,0,0,0"/>

            </Border>

            <Border Grid.Row="1" Width="Auto"
         Margin="10,5"
         Background="#31394A"
         BorderBrush="#252c3B"
                    BorderThickness="2"
         CornerRadius="20">

                <TextBlock Text="{Binding errorText}"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="GhostWhite"
                Padding="10"
                Margin="0,50,0,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
               
            </Border>
            <!-- Error message text block at function customerNameTextBox_empty HomeViewXaml.cs-->
            <Grid Grid.Row="1" Width="Auto">
                <TextBlock Text="{Binding plogo}"
   Foreground="{Binding plogoForeground}"
   FontSize="30"
   FontWeight="Bold"
  HorizontalAlignment="Center"
VerticalAlignment="Center"
                           Margin="0,-50,0,0"/>
            </Grid>
            <Button Grid.Row="2"
         Content="{Binding mbutText}"
         Width="80"
         HorizontalAlignment="Center"
         VerticalAlignment="Center" Style="{StaticResource okBtn}" Click="okBtn" Visibility="{Binding mbutVisibility}" BorderThickness="{Binding mbuttonthickness}"/>
            <Button Grid.Row="2"
Content="{Binding lbutText}"
Width="80"
HorizontalAlignment="Center"
VerticalAlignment="Center" Style="{StaticResource okBtn}" Click="rbutton" Margin="-120,0,0,0" Visibility="{Binding yVisibility}" BorderThickness="{Binding rbuttonthickness}"/>
            <Button Grid.Row="2"
Content="{Binding rbutText}"
Width="80"
HorizontalAlignment="Center"
VerticalAlignment="Center" Style="{StaticResource okBtn}" Click="lbutton" Margin="120,0,0,0" Visibility="{Binding lVisibility}" BorderThickness="{Binding lbuttonthickness}"/>
            <Ellipse Stroke="{Binding EllipseStroke}" Margin="102,21,102,68" Grid.Row="1" StrokeThickness="2.5" Visibility="{Binding EllipseVisibility}" />
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="70*"/>
                <RowDefinition Height="25*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Border>
</Window>
