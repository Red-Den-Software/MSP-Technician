<Window x:Class="msptool.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tm="clr-namespace:msptool.Commands.UpdateViewCommand"
        xmlns:local="clr-namespace:msptool.Views"
        xmlns:viewmodels="clr-namespace:msptool.ViewModels"
        
        xmlns:views="clr-namespace:msptool.Views" xmlns:commands="clr-namespace:msptool.Commands.UpdateViewCommand" xmlns:mvvm="clr-namespace:msptool.MVVM" d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        mc:Ignorable="d" WindowStyle="None"
        Title="ShellView" Height="450" Width="878"
        AllowsTransparency="true"
        Background="Transparent"
      
   >
    <Border CornerRadius="25" BorderThickness="1" Padding="2,0,0,0" Background="{Binding GlassBackgroundBrush}">



        <Grid Margin="0,-8,-82,-8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="40*"/>


            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="420*"/>


            </Grid.RowDefinitions>


            <StackPanel Panel.ZIndex="0" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Row="1" Height="320" Width="218">
                <Border BorderThickness="1" CornerRadius="10" Height="74">

                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF80D8FF" Offset="0.0" />
                            <GradientStop Color="#FF0057FF" Offset="0.5" />
                            <GradientStop Color="#FF00008B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Button  x:Name="hoBtn" Command="{Binding UpdateViewCommand}" Style="{StaticResource MenuBtnstyle}" CommandParameter="Home" Content="Home" FontFamily="Calibri Light"  FontSize="26" VerticalAlignment="Center" Height="74" Width="217">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Border>


                <Border BorderThickness="1" CornerRadius="10" Height="74" Margin="0,4,0,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF80D8FF" Offset="0.0" />
                            <GradientStop Color="#FF0057FF" Offset="0.5" />
                            <GradientStop Color="#FF00008B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Button x:Name="toBtn" Command="{Binding UpdateViewCommand}" Style="{StaticResource MenuBtnstyle}" CommandParameter="Tools" Content="Tools" FontSize="26" FontFamily="Calibri Light" Height="74" Margin="0,0,0,-2" Width="217">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" Height="74" Margin="0,4,0,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF80D8FF" Offset="0.0" />
                            <GradientStop Color="#FF0057FF" Offset="0.5" />
                            <GradientStop Color="#FF00008B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Button x:Name="loBtn" Command="{Binding LogsCommand}" Style="{StaticResource MenuBtnstyle}" Content="Logs" FontSize="26" FontFamily="Calibri Light" Margin="0,-1,0,-2" Width="217"
                    >

                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" Height="74" Margin="0,4,0,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF80D8FF" Offset="0.0" />
                            <GradientStop Color="#FF0057FF" Offset="0.5" />
                            <GradientStop Color="#FF00008B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Button x:Name="abtBtn" Command="{Binding AboutCommand}" Style="{StaticResource MenuBtnstyle}" Content="About" FontSize="26" FontFamily="Calibri Light" Margin="0,-1,0,-2" Width="217">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Border>


            </StackPanel>

            <StackPanel Panel.ZIndex="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="725,0,0,0" Height="35" Width="0"/>


            <Grid Grid.Column="1" Margin="59,16,110,17" Grid.Row="1">
                <Border CornerRadius="25" BorderThickness="2" Background="{Binding GlassBackgroundBrush}" >
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF80D8FF" Offset="0.0" />
                            <GradientStop Color="#FF0057FF" Offset="0.5" />
                            <GradientStop Color="#FF00008B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <ContentControl x:Name="UpdateContentControl" Content="{Binding CurrentView}" />
                </Border>
            </Grid>

            <Button x:Name="btnClose"  Style="{StaticResource btnClose}" Content="X" Grid.Column="1" Margin="604,8,82,8" Padding="0,0,0,0" Height="24" Width="48" VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="0,25,0,0"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="btnMinimize" Style="{StaticResource btnMinimize}" CommandParameter="btnMinimize"  Content="🗕" Grid.Column="1" Height="24" Width="48" Margin="558,8,131,8" FontSize="24" Padding="0,-24,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="0"/>
                    </Style>
                </Button.Resources>

            </Button>
            <Ellipse x:Name="HelpEllipse"
         HorizontalAlignment="Left"
         Height="38"
         Margin="6,355,0,0"
         Grid.Row="1"
         Stroke="Transparent"
         VerticalAlignment="Top"
         Width="38"
         Fill="CornflowerBlue"
         Cursor="Hand"
         MouseLeftButtonDown="HelpEllipse_MouseLeftButtonDown"/>
            <TextBlock HorizontalAlignment="Left" Margin="18,356,0,0" Grid.Row="1" TextWrapping="Wrap" Text="?" VerticalAlignment="Top" FontFamily="Calibri Light" Foreground="GhostWhite" FontSize="30" FontWeight="Bold"/>

            <Rectangle x:Name="HelpRect"
           HorizontalAlignment="Left"
           Height="70"
           Margin="49,339,0,0"
           Grid.Row="1"
           Fill="#31394A"
           VerticalAlignment="Top"
           Width="0"
           Opacity="0"
           RadiusX="20"
           RadiusY="20"/>

            <TextBlock x:Name="HelpText"
           HorizontalAlignment="Left"
           Margin="61,354,0,0"
           Grid.Row="1"
           Text="Need Assistance? Checkout the About Tab"
           VerticalAlignment="Top"
           Height="55"
           Width="142"
           FontFamily="Calibri Light"
           Foreground="GhostWhite"
           FontSize="14"
           FontWeight="Bold"
           Opacity="0"
           Cursor="Hand"
            IsHitTestVisible="False"
                       TextWrapping="Wrap"
                       />



        </Grid>
        
    </Border>
</Window>

