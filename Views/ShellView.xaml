<Window x:Class="msptool.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tm="clr-namespace:msptool.Commands.UpdateViewCommand"
        xmlns:local="clr-namespace:msptool.Views"
        xmlns:viewmodels="clr-namespace:msptool.ViewModels"
        
        xmlns:views="clr-namespace:msptool.Views" xmlns:commands="clr-namespace:msptool.Commands.UpdateViewCommand" xmlns:mvvm="clr-namespace:msptool.MVVM" d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        mc:Ignorable="d" WindowStyle="None"
        Title="ShellView" Height="450" Width="878"
        AllowsTransparency="true"
        Background="Transparent"
      
   >
    <Border CornerRadius="25" BorderThickness="1" Padding="2,0,0,0" Background="#121212">



        <Grid Margin="0,-8,-82,-8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="40*"/>


            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="420*"/>


            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#1D1D1D" 
        BorderThickness="2" 
        CornerRadius="25" 
        Background="#1D1D1D"
                    Height="420"
                    Width="210"
                    Margin="10,0,0,0"
                    >

                <StackPanel Panel.ZIndex="0" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Row="1" Height="410" Width="218" Background="Transparent" >
                    <Button  x:Name="hoBtn" Command="{Binding UpdateViewCommand}" Style="{StaticResource MenuBtnstyle}" CommandParameter="Home" Content="Home" FontFamily="Calibri Light"  FontSize="26" VerticalAlignment="Center" Width="217" Margin="0,0,0,0"/>
                    <Button x:Name="toBtn" Command="{Binding UpdateViewCommand}" Style="{StaticResource MenuBtnstyle}" CommandParameter="Tools" Content="Tools" FontSize="26" FontFamily="Calibri Light"  Margin="0,10,0,0" Width="217"/>
                    <Button x:Name="loBtn" Command="{Binding LogsCommand}" Style="{StaticResource MenuBtnstyle}" Content="Logs" FontFamily="Calibri Light" Margin="0,10,0,0" Width="217" FontSize="26"/>
                    <Button x:Name="abtBtn" Command="{Binding AboutCommand}" Style="{StaticResource MenuBtnstyle}" Content="About" FontSize="26" FontFamily="Calibri Light" Margin="0,10,0,0" Width="217"/>
                </StackPanel>
            </Border>
            <StackPanel Panel.ZIndex="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="725,0,0,0" Height="35" Width="0"/>


            <Grid Grid.Column="1" Margin="59,16,110,22" Grid.Row="1">
                <Border CornerRadius="25" BorderThickness="2" Background="{Binding GlassBackgroundBrush}" BorderBrush="#1D1D1D" >
                    <ContentControl x:Name="UpdateContentControl" Content="{Binding CurrentView}" />
                </Border>
            </Grid>

            <Button x:Name="btnClose"  Style="{StaticResource btnClose}" Content="X" Grid.Column="1" Margin="604,8,82,8" Padding="0,0,0,0" Height="24" Width="48" VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="0,25,0,0"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="btnMinimize" Style="{StaticResource btnMinimize}" CommandParameter="btnMinimize"  Content="🗕" Grid.Column="1" Height="24" Width="48" Margin="558,8,131,8" FontSize="24" Padding="0,-24,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="0"/>
                    </Style>
                </Button.Resources>

            </Button>
           


        </Grid>

    </Border>
</Window>

